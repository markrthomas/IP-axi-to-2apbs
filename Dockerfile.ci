FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:${PATH}"

# Install the OS packages required by the repo
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    g++ \
    gcc \
    make \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    iverilog \
    verilator \
    wget \
    gtkwave \
    pandoc \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    yosys \
    symbiyosys \
    && rm -rf /var/lib/apt/lists/*

# Python tooling used by cocotb / pyuvm
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install cocotb pyuvm

WORKDIR /workspace
COPY . /workspace

# Keep the image CI-safe and non-root
RUN groupadd --system dev \
    && useradd --system --gid dev --create-home --home-dir /home/dev dev \
    && chown -R dev:dev /workspace /opt/venv

USER dev

# Default action should be a repo smoke check, not an interactive shell
CMD ["bash", "-lc", "make help"]
