# -----------------------------------------------------------------------------
# CI SMOKE image — full open-source toolchain for the non-UVM flows.
#
# One of three images in this repo, each with a distinct role:
#   Dockerfile      UVM-on-Verilator gate (Verilator 5.050 from source) — Railway
#                   / docker-image.yml.  The only one that can run `uvm/vlt`.
#   Dockerfile.dev  lean devcontainer (apt verilator/iverilog + cocotb/pyuvm) —
#                   used by .devcontainer/devcontainer.json.
#   Dockerfile.ci   THIS: dev toolchain + gtkwave/pandoc/texlive/yosys, for
#                   running the repo's smoke checks in a container (built and
#                   exercised by .github/workflows/docker-ci-image.yml).
# NOTE: apt Verilator on ubuntu:22.04 is 4.x — not UVM-capable AND too old for the
# repo's Verilator-5 lint codes (e.g. UNUSEDSIGNAL), so the Verilator flows
# (`make check`/lint/coverage) do NOT work here.  This image is for the iverilog
# directed tests and the icarus-backed cocotb suite; use the root Dockerfile
# (Verilator 5.050 from source) for the Verilator/UVM flows.
# Build: docker build -f Dockerfile.ci -t ip-axi-2apbs-ci .
# -----------------------------------------------------------------------------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:${PATH}"

# Install the OS packages required by the repo
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    g++ \
    gcc \
    make \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    iverilog \
    verilator \
    wget \
    gtkwave \
    pandoc \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    yosys \
    && rm -rf /var/lib/apt/lists/*

# NOTE: SymbiYosys (sby) is NOT an apt package — it ships via the OSS CAD Suite or
# a source build (see .github/workflows/verilator-sim.yml). `make formal` checks
# for `sby` and degrades gracefully when absent, so it is simply skipped here.
# Add SymbiYosys from OSS CAD Suite / source if this image needs the formal flow.

# Python tooling used by cocotb / pyuvm
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install cocotb pyuvm

WORKDIR /workspace
COPY . /workspace

# Keep the image CI-safe and non-root
RUN groupadd --system dev \
    && useradd --system --gid dev --create-home --home-dir /home/dev dev \
    && chown -R dev:dev /workspace /opt/venv

USER dev

# Default action should be a repo smoke check, not an interactive shell
CMD ["bash", "-lc", "make help"]
