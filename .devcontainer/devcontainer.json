{
  "name": "IP-axi-to-2apbs",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": ".."
  },
  "remoteUser": "dev",
  "containerUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
