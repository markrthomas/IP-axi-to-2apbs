# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=ip-axi-to-2apbs
GH_REPO=markrthomas/ip-axi-to-2apbs
DUT_TOP=axi4_to_apb4_2x_burst

RTL_DIR=src
TB_DIR=test

DV_ENVS="test-all cocotb pyuvm"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal check-uvm-mirror report_check"
HEAVY_TARGETS="coverage ci"

MUTATION_FILE=src/axi4_to_apb4_2x_burst.v
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=test/random
RR_STATUS=bootstrap

METRICS=no

# repo-owned: the tuned UVM-on-Verilator entrypoint (toolchain overrides, memory preflight, Railway log trimming)
# and the Railway IaC in .railway/railway.ts stay; the kit only adds swarm/agent modes to the entrypoint.
KIT_KEEP="docker/entrypoint.sh railway.toml .devcontainer/devcontainer.json"
